FROM python:3.12.13-slim-bookworm@sha256:76d4b7b6305788c6b4c6a19d6a22a3921bf802e9af4d5e1e5bd771208dba74bf
RUN addgroup --system rlm && adduser --system --ingroup rlm --uid 10001 rlm
WORKDIR /opt/rlm
COPY src/openjarvis/agents/rlm_sandbox_protocol.py rlm_sandbox_protocol.py
COPY src/openjarvis/agents/rlm_worker.py rlm_worker.py
COPY src/openjarvis/agents/rlm_interpreter rlm_interpreter
USER rlm
ENTRYPOINT ["python", "/opt/rlm/rlm_worker.py"]
